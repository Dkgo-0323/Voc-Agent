ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

FROM base AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /bin/uv
ENV UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project
COPY backend ./backend
COPY pipelines ./pipelines
COPY shared ./shared
COPY scripts/check_distribution.py ./scripts/check_distribution.py
RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel --out-dir /wheels && \
    uv pip install --python .venv/bin/python --no-deps /wheels/*.whl && \
    .venv/bin/python scripts/check_distribution.py /wheels/*.whl --python .venv/bin/python

FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 voc && useradd --uid 10001 --gid voc --create-home voc
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY alembic.ini ./alembic.ini
# Resolve migrations from the installed wheel, independently of the checkout.
RUN sed -i 's|%(here)s/backend/app/db/migrations|backend:app/db/migrations|' alembic.ini
ENV PATH="/app/.venv/bin:$PATH"
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
