# .env.example
# 复制为 .env 并填入真实值
# cp .env.example .env

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=voc
POSTGRES_PASSWORD=vocpassword
POSTGRES_DB=vocdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 完整异步连接串（asyncpg驱动）
# 格式：postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://voc:vocpassword@localhost:5432/vocdb

# ─── Milvus ───────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ─── MinIO（Milvus依赖） ──────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── Reddit API（PRAW） ───────────────────────────────────────
# 在 https://www.reddit.com/prefs/apps 申请
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=voc-agent/0.1 by your_reddit_username

# ─── OpenAI ───────────────────────────────────────────────────
# 用于 Embedding（text-embedding-3-small）和 Agent LLM
OPENAI_API_KEY=sk-your-openai-api-key

# ─── JWT鉴权 ──────────────────────────────────────────────────
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-secret-key-replace-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ─── 管理员密码（单密码模式） ──────────────────────────────────
ADMIN_PASSWORD=change-me-in-production

# ─── 应用配置 ─────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1