# .env.example
# 复制为 .env 并填入真实值
# cp .env.example .env

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=voc
POSTGRES_PASSWORD=vocpassword
POSTGRES_DB=vocdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 完整异步连接串（asyncpg驱动）
# 格式：postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://voc:vocpassword@localhost:5432/vocdb

# ─── Milvus ───────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aspect_mentions_vectors_1024

# ─── MinIO（Milvus依赖） ──────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── Reddit API（PRAW） ───────────────────────────────────────
# 在 https://www.reddit.com/prefs/apps 申请
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=voc-agent/0.1 by your_reddit_username

# ─── Legacy OpenAI ────────────────────────────────────────────
# 仅用于兼容旧配置；新接入优先使用下面的 LLM_* / EMBEDDING_*。
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Enrichment LLM（默认智谱 GLM-4-FlashX）──────────────────
# LLM_API_KEY 留空时，如果 LLM_BASE_URL 与 EMBEDDING_BASE_URL 相同，
# Worker 会安全复用 EMBEDDING_API_KEY。
# FlashX 是低价高并发型号；如只做开发试用，可改用免费 glm-4.7-flash，
# 并设置 LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flashx-250414
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_EXTRA_BODY='{}'
# Dashboard 与 RAG 默认只使用达到该确定性质量阈值的 Mention；原始记录仍保留在 PostgreSQL。
ASPECT_QUALITY_THRESHOLD=0.55
# Analytics remains queryable below this review count, but returns a warning.
MIN_RELIABLE_SAMPLE=20
# Maximum number of traceable evidence items returned by one RAG tool call.
MAX_RAG_TOP_K=20
# Number of visible user/assistant messages supplied to the Agent each turn.
RECENT_MESSAGE_LIMIT=8

# ─── Embedding Provider（正式采用智谱 embedding-3）──────────
# EMBEDDING_DIMENSIONS 是应用、Embedding API 与 Milvus Collection 的唯一维度契约。
# 启动时会调用一次维度探针，并校验已有 Collection 的 vector 字段；不一致将拒绝启动和写入。
EMBEDDING_API_KEY=your-zhipu-api-key
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# ─── JWT鉴权 ──────────────────────────────────────────────────
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-256-bit-secret-key-replace-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ─── 管理员密码（单密码模式） ──────────────────────────────────
ADMIN_PASSWORD=change-me-in-production

# ─── 应用配置 ─────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
